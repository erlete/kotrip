# =============================================================================
# Entorno general
# =============================================================================
# Entorno de ejecución de Node.js (development|production|test).
# En Docker se sobreescribe vía compose.
NODE_ENV=development

# REQUIRED: Zona horaria por defecto de todos los contenedores.
TZ=

# REQUIRED: Idioma por defecto cuando el usuario no tiene preferencia guardada.
FALLBACK_LANGUAGE=

# OPTIONAL: Índice de stack (por defecto, 0), utilizado para diferenciar múltiples instancias de despliegue de compose completos.
# WARNING: Un cambio en el índice de stack requiere un reup de los servicios para actualizar los puertos de exposición de los servicios (ej. backend: 3050 -> 3150, frontend: 3060 -> 3160, etc.).
STACK_INDEX=0

# OPTIONAL: Nombre de proyecto (por defecto, "kotrip"), utilizado para prefijar los nombres de los contenedores en despliegues con múltiples stacks.
# WARNING: Un cambio en nombre de proyecto requiere un rebuild de las imágenes para actualizar las etiquetas usadas en los servicios (ej. kotrip/backend:prod -> otro/backend:prod).
PROJECT_NAME=kotrip

# =============================================================================
# PostgreSQL
# =============================================================================
# Host del servicio PostgreSQL. En Docker se sobreescribe con el nombre del
# contenedor ('postgres') vía compose.
POSTGRES_HOST=postgres

# Puerto interno de PostgreSQL.
POSTGRES_PORT=5432

# REQUIRED: Usuario de la base de datos PostgreSQL para el backend.
# Generar: openssl rand -base64 16 | tr -d '\n'
POSTGRES_USER=

# REQUIRED: Contraseña del usuario de PostgreSQL.
# Generar: openssl rand -base64 48 | tr -d '\n'
POSTGRES_PASSWORD=

# REQUIRED: Nombre de la base de datos usada por el backend.
POSTGRES_DB=

# =============================================================================
# Redis de backend (backend-redis)
# =============================================================================
# Puerto interno del servicio Redis de backend.
BACKEND_REDIS_PORT=6379

# REQUIRED: Contraseña de Redis para el backend (sesiones, cachés backend, etc.).
# Generar: openssl rand -base64 48 | tr -d '\n'
BACKEND_REDIS_PASSWORD=

# =============================================================================
# MinIO (almacenamiento de ficheros tipo S3)
# =============================================================================
# REQUIRED: Usuario root de MinIO (access key).
# Generar: openssl rand -base64 16 | tr -d '\n'
MINIO_ROOT_USER=

# REQUIRED: Contraseña root de MinIO (secret key).
# Generar: openssl rand -base64 48 | tr -d '\n'
MINIO_ROOT_PASSWORD=

# REQUIRED: Nombre del bucket por defecto utilizado por el Kotrip.
MINIO_DEFAULT_BUCKET=

# OPTIONAL: Política de acceso del bucket (none|download|public).
MINIO_BUCKET_POLICY=

# OPTIONAL: Tiempo de validez de los enlaces firmados de MinIO (segundos).
MINIO_SHARE_EXPIRATION_SECONDS=

# OPTIONAL: URL base pública para compartir archivos de MinIO.
# En desarrollo local: http://localhost:3032
# En producción: URL pública del servidor MinIO o proxy.
MINIO_SHARE_BASE_URL=

# =============================================================================
# ClamAV (antivirus)
# =============================================================================
# OPTIONAL: Tamaño máximo de fichero aceptado por ClamAV (ej. 200M).
CLAMAV_MAX_FILE_SIZE=

# OPTIONAL: Tamaño máximo de escaneo de ClamAV (ej. 200M).
CLAMAV_MAX_SCAN_SIZE=

# OPTIONAL: Longitud máxima de stream para ClamAV (ej. 200M).
CLAMAV_STREAM_MAX_LENGTH=

# OPTIONAL: Timeout de escaneo de ClamAV en milisegundos.
CLAMAV_TIMEOUT=


# =============================================================================
# Tokens de reseteo de contraseña
# =============================================================================
# REQUIRED: Clave secreta para generar tokens de reseteo de contraseña.
# Generar: openssl rand -base64 48 | tr -d '\n'
RESET_KEY=

# =============================================================================
# Cifrado simétrico
# =============================================================================
# REQUIRED: Clave de cifrado simétrico (32 bytes en hex).
# Generar: openssl rand -hex 32
ENCRYPTION_KEY=

# REQUIRED: Vector de inicialización (16 bytes en hex).
# Generar: openssl rand -hex 16
IV=

# =============================================================================
# JWT / sesiones
# =============================================================================

# OPTIONAL: Habilitar el uso de JWT globalmente (true|false).
JWT_GLOBAL=true

# REQUIRED: Secreto para los JWT de acceso.
# Generar: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# REQUIRED: Secreto para los tokens de refresco/sesión.
# Generar: openssl rand -base64 64 | tr -d '\n'
JWT_REFRESH_SECRET=

# REQUIRED: Tiempo de expiración de los tokens de acceso (ej. 15m, 900s).
# IMPORTANTE: Frontend debe usar el mismo valor en COOKIE_ACCESS_TOKEN_MAX_AGE
JWT_EXPIRATION=15m

# REQUIRED: Tiempo de expiración de los tokens de refresco (ej. 30d).
# IMPORTANTE: Frontend debe usar el mismo valor en COOKIE_REFRESH_TOKEN_MAX_AGE
JWT_REFRESH_EXPIRATION=30d

# REQUIRED: Tiempo de expiración de los enlaces de invitación (ej. 1h, 60m).
INVITE_EXPIRATION=1h

# REQUIRED (Frontend): Clave secreta para encriptar/desencriptar las cookies de autenticación.
# Generar: openssl rand -hex 32
# Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# =============================================================================
# Cookies y Token Refresh (Frontend/Backend compartido)
# =============================================================================

# REQUIRED: Habilitar cookies seguras (true|false). En producción debe ser true para usar cookies con Secure.
COOKIE_SECURE=true

# REQUIRED: Duración de la cookie de access token (debe coincidir con JWT_EXPIRATION).
# Formato: <número><unidad> donde unidad = ms|s|m|h|d|w
# Ejemplos: "15m" = 15 minutos, "900s" = 900 segundos
COOKIE_ACCESS_TOKEN_MAX_AGE=15m

# REQUIRED: Duración de la cookie de refresh token (debe coincidir con JWT_REFRESH_EXPIRATION).
COOKIE_REFRESH_TOKEN_MAX_AGE=30d

# REQUIRED: Duración de la cookie de sesión (debe coincidir con refresh token).
COOKIE_SESSION_MAX_AGE=30d

# OPTIONAL: Porcentaje de vida del token antes de trigger refresh automático.
# 0.8 = refrescar cuando se alcance el 80% de tiempo de vida (ej: 12min en un token de 15min)
# Menor = refreshes más frecuentes, Mayor = refreshes menos frecuentes pero más cerca de la expiración
TOKEN_REFRESH_THRESHOLD=0.8

# OPTIONAL: Tiempo mínimo entre actualizaciones de cookie de sesión (sliding window throttle).
# Previene escrituras excesivas de cookies en cada navegación.
# Recomendado: 5-10 minutos
SESSION_UPDATE_THROTTLE=5m


# =============================================================================
# PGAdmin (solo si se usa)
# =============================================================================
PGADMIN_DEFAULT_EMAIL=email@example.com
PGADMIN_DEFAULT_PASSWORD=password

# =============================================================================
# Conexión al backend (frontend -> backend)
# =============================================================================

# Host o dirección IP del backend. En Docker se sobreescribe automáticamente
# con el nombre del servicio Docker ('backend') vía compose.
# - Desarrollo local (frontend nativo, backend en Docker): 127.0.0.1
# - Desarrollo remoto (backend en IP remota): <IP>
# - Producción (dominio TLD del backend): backend.example.com
BACKEND_CLUSTER_HOST=127.0.0.1

# OPTIONAL: Puerto del backend cuando se accede desde fuera del clúster Docker.
# Por defecto: 3050 para IPs/localhost, ninguno para dominios (HTTPS estándar).
# BACKEND_CLUSTER_PORT=3050
