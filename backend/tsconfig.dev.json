{
  "display": "Configuración de TypeScript para desarrollo",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": ".tsbuildinfo.dev",
    "incremental": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@/common/*": ["src/common/*"],
      "@/content/*": ["src/modules/content/*"],
      "@/delivery/*": ["src/modules/delivery/*"],
      "@/user/*": ["src/modules/user/*"],
      "@/lib/*": ["src/lib/*"]
    },
    "types": ["node", "express", "multer"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.e2e-spec.ts"]
}
