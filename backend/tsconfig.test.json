{
  "display": "Configuración de TypeScript para tests y compilación sin emisión",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@/common/*": ["src/common/*"],
      "@/content/*": ["src/modules/content/*"],
      "@/delivery/*": ["src/modules/delivery/*"],
      "@/user/*": ["src/modules/user/*"],
      "@/lib/*": ["src/lib/*"]
    },
    "types": ["jest", "node", "express", "multer"]
  },
  // "include": ["src", "src/**/*.spec.ts", "src/**/*.e2e-spec.ts"]
  "include": ["src"]
}
