{
  "name": "@kotrip/data",
  "version": "0.0.0",
  "private": true,
  "description": "Shared data types and enums for Kotrip project",
  "license": "UNLICENSED",
  "author": "Kotrip",
  "maintainers": [
    {
      "name": "Paulo Sánchez",
      "email": "dev.szblzpaulo@gmail.com",
      "url": "https://github.com/erlete"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "qa:docs": "typedoc --options typedoc.json",
    "qa:docs:serve": "typedoc --options typedoc.json --watch --serve",
    "qa:docs:watch": "typedoc --options typedoc.json --watch"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.17",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^24"
  }
}
