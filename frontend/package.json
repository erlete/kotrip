{
  "name": "@kotrip/frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/npm/prebuild.mjs",
    "build": "next build",
    "clean": "rimraf .next out .eslintcache tsconfig.tsbuildinfo next-env.d.ts",
    "postinstall": "node ./scripts/npm/postinstall.mjs",
    "qa": "run-s qa:lint qa:compile",
    "qa:compile": "tsc -p tsconfig.json",
    "qa:docs": "typedoc --options typedoc.json",
    "qa:docs:serve": "typedoc --options typedoc.json --watch --serve",
    "qa:docs:watch": "typedoc --options typedoc.json --watch",
    "qa:i18n-audit": "node scripts/modules/i18n-audit.mjs",
    "qa:i18n-sync": "node scripts/modules/i18n-sync.mjs",
    "qa:lint": "eslint --config eslint.config.mjs --max-warnings=0 --cache .",
    "qa:lint:fix": "eslint --config eslint.config.mjs --fix --max-warnings=0 --cache .",
    "qa:usage": "knip --max-issues=0 --cache",
    "qa:usage:fix": "knip --fix --max-issues=0 --cache",
    "routes:generate": "node scripts/modules/generate-route-registry.mjs",
    "routes:watch": "npx nodemon --watch src/app --ext ts,tsx --signal SIGTERM --exec \"npm run routes:generate\"",
    "prestart:dev": "node ./scripts/npm/prestart.mjs",
    "start:dev": "next dev --webpack",
    "start:prod": "node .next/standalone/frontend/server.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@heroui/react": "3.0.0-beta.8",
    "@heroui/styles": "3.0.0-beta.8",
    "@hookform/resolvers": "5.2.2",
    "@kotrip/data": "0.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tiptap/extension-color": "3.20.1",
    "@tiptap/extension-highlight": "3.20.1",
    "@tiptap/extension-image": "3.20.1",
    "@tiptap/extension-link": "3.20.1",
    "@tiptap/extension-placeholder": "3.20.1",
    "@tiptap/extension-table": "3.20.1",
    "@tiptap/extension-table-cell": "3.20.1",
    "@tiptap/extension-table-header": "3.20.1",
    "@tiptap/extension-table-row": "3.20.1",
    "@tiptap/extension-text-align": "3.20.1",
    "@tiptap/extension-underline": "3.20.1",
    "@tiptap/pm": "3.20.1",
    "@tiptap/react": "3.20.1",
    "@tiptap/starter-kit": "3.20.1",
    "apexcharts": "5.6.0",
    "clsx": "2.1.1",
    "cobe": "0.6.3",
    "dompurify": "3.3.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.575.0",
    "next": "16.1.6",
    "next-intl": "4.8.3",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.31",
    "react": "19.2.4",
    "react-apexcharts": "2.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.1",
    "use-intl": "4.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-i18next": "^6.1.3",
    "knip": "^5.84.1",
    "rollup": "^4.59.0",
    "typedoc": "^0.28.17",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.9.3"
  }
}
